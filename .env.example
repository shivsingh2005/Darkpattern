# Application Settings
APP_NAME="Dark Pattern Detection API"
APP_VERSION="2.0.0"
ENVIRONMENT=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4
RELOAD=true

# Database
DATABASE_URL=sqlite:///./darkpattern.db
# PostgreSQL example: postgresql://user:password@localhost/darkpattern
DATABASE_ECHO=false
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Security
SECRET_KEY=your-secret-key-change-in-production
API_KEY=
API_KEYS=
REQUIRE_API_KEY=false
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_REQUESTS_PER_HOUR=1000

# Logging
LOG_LEVEL=INFO
LOG_FILE=
SENTRY_DSN=

# ML Model
MODEL_PATH=
VECTORIZER_PATH=
MODEL_VERSION=1.0.0
CACHE_PREDICTIONS=true
CACHE_TTL_SECONDS=3600
BATCH_SIZE=32

# External Services
GEMINI_API_KEY=
REDIS_URL=

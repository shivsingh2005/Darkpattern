# Comma-separated origins for CORS. Use * only for non-production testing.
CORS_ORIGINS=https://your-frontend-domain.com

# Optional Gemini key for LLM explanations. If omitted, fallback explanations are used.
GEMINI_API_KEY=

# Optional logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Optional gunicorn settings used by Docker CMD
WEB_CONCURRENCY=2
GUNICORN_TIMEOUT=120
